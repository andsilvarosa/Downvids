{
  "name": "video-downloader-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev dist",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/_worker.js",
    "deploy": "wrangler pages deploy dist",
    "db:init": "wrangler d1 execute video-downloader-db --local --file=./schema.sql",
    "db:prod": "wrangler d1 execute video-downloader-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.2.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "^4.20240405.0",
    "typescript": "^5.0.0",
    "esbuild": "^0.20.2"
  }
}
